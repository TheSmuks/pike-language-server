{
	"fileTypes": [
		"pike",
		"pmod",
		"cmod",
		"mmod"
	],
	"firstLineMatch": "(-[*]-( [Mm]ode:)? [Pp]ike -[*]-|^#!/.*\\bpike\\b)",
	"foldingStartMarker": "(?x)\n     /\\*\\*(?!\\*)\n    |^(?![^{]*?//|[^{]*?/\\*(?!.*?\\*/.*?\\{)).*?\n    \\{\\s*($|//|/\\*(?!.*?\\*/.*\\S))\n    |(^\\s*//\\s*(\\{\\{\\{))",
	"foldingStopMarker": "(?<!\\*)\\n\\*\\*/|^\\s*\\}|//\\s*\\}\\}\\}$",
	"keyEquivalent": "^~C",
	"name": "Pike",
	"patterns": [
		{
			"include": "#preprocessor-rule-enabled"
		},
		{
			"include": "#preprocessor-rule-enabled-block"
		},
		{
			"include": "#preprocessor-rule-disabled"
		},
		{
			"include": "#preprocessor-rule-disabled-block"
		},
		{
			"include": "#preprocessor-rule-other"
		},
		{
			"include": "#preprocessor-rule-other-block"
		},
		{
			"include": "#disabled"
		},
		{
			"include": "#parens"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#pragma-mark"
		},
		{
			"include": "#builtin-modules"
		},
		{
			"include": "#builtin-functions"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#fncall"
		},
		{
			"include": "#block"
		},
		{
			"include": "#operators"
		},
		{
			"comment": "Control flow keywords",
			"match": "\\b(if|else|while|for|foreach|do|return|continue|break|switch|case|default|goto|catch|lambda|gauge|inherit|import)\\b",
			"name": "keyword.control.pike"
		},
		{
			"match": "\\b(enum|float|int|typedef|void|object|class|mapping|string|array|multiset|mixed|function|program|bool|auto)\\b",
			"name": "storage.type.pike"
		},
		{
			"comment": "Modifiers",
			"match": "\\b(public|protected|private|constant|inline|local|final|optional|variant)\\b",
			"name": "storage.modifier.pike"
		},
		{
			"comment": "Numeric values",
			"match": "(?:\\b|(?<!\\.)(?=\\.))((0(x|X)[0-9a-fA-F]*)|(0(b|B)[01]+)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)\\b",
			"name": "constant.numeric.pike"
		},
		{
			"comment": "Language constants",
			"match": "\\b(UNDEFINED|__LINE__|__FILE__|__DIR__|__func__|__VERSION__|__MAJOR__|__MINOR__|__BUILD__|__REAL_VERSION__|__REAL_MAJOR__|__REAL_MINOR__|__REAL_BUILD__|__DATE__|__TIME__|__AUTO_BIGNUM__|__NT__|__PIKE__|__amigaos__|true|false|this|this_program)\\b",
			"name": "constant.language.pike"
		},
		{
			"begin": "\"",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.pike"
				}
			},
			"end": "\"",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.pike"
				}
			},
			"name": "string.quoted.double.pike",
			"patterns": [
				{
					"include": "#string_escaped_char"
				},
				{
					"include": "#string_placeholder"
				}
			]
		},
		{
			"begin": "'",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.pike"
				}
			},
			"end": "'",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.pike"
				}
			},
			"name": "string.quoted.single.pike",
			"patterns": [
				{
					"include": "#string_escaped_char"
				}
			]
		},
		{
			"begin": "(?x)\n                 ^\\s*\\#\\s*(define)\\s+           # define\n                 ((?<id>[a-zA-Z_][a-zA-Z0-9_]*))    # macro name\n                 (?:                                # and optionally:\n                   (\\()                            # an open parenthesis\n                     (\n                       \\s* \\g<id> \\s*            # first argument\n                       ((,) \\s* \\g<id> \\s*)*     # additional arguments\n                       (?:\\.\\.\\.)?               # varargs ellipsis?\n                     )\n                   (\\))                             # a close parenthesis\n                 )?",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.import.define.pike"
				},
				"2": {
					"name": "entity.name.function.preprocessor.pike"
				},
				"4": {
					"name": "punctuation.definition.parameters.pike"
				},
				"5": {
					"name": "variable.parameter.preprocessor.pike"
				},
				"7": {
					"name": "punctuation.separator.parameters.pike"
				},
				"8": {
					"name": "punctuation.definition.parameters.pike"
				}
			},
			"end": "(?=(?://|/\\*))|$|\\n",
			"name": "meta.preprocessor.macro.pike",
			"patterns": [
				{
					"match": "(?>\\\\\\s*\\n)",
					"name": "punctuation.separator.continuation.pike"
				},
				{
					"include": "$base"
				}
			]
		},
		{
			"begin": "^\\s*#\\s*(error|warning)\\b",
			"captures": {
				"1": {
					"name": "keyword.control.import.error.pike"
				}
			},
			"end": "$",
			"name": "meta.preprocessor.diagnostic.pike",
			"patterns": [
				{
					"match": "(?>\\\\\\s*\\n)",
					"name": "punctuation.separator.continuation.pike"
				}
			]
		},
		{
			"begin": "^\\s*#\\s*(include|string)\\b",
			"captures": {
				"1": {
					"name": "keyword.control.import.include.pike"
				}
			},
			"end": "(?=(?://|/\\*))|$",
			"name": "meta.preprocessor.include.pike",
			"patterns": [
				{
					"match": "(?>\\\\\\s*\\n)",
					"name": "punctuation.separator.continuation.pike"
				},
				{
					"begin": "\\\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.pike"
						}
					},
					"end": "\\\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.pike"
						}
					},
					"name": "string.quoted.double.include.pike"
				},
				{
					"begin": "<",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.pike"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.pike"
						}
					},
					"name": "string.quoted.other.lt-gt.include.pike"
				}
			]
		},
		{
			"begin": "^\\s*#\\s*(define|defined|elif|elseif|else|if|ifdef|ifndef|(line|[0-9]+)|pragma|undef|undefine|endif|charset|pike|string|require|COUNTER|warning|error)\\b",
			"captures": {
				"1": {
					"name": "keyword.control.import.pike"
				}
			},
			"end": "(?=(?://|/\\*))|$",
			"name": "meta.preprocessor.pike",
			"patterns": [
				{
					"match": "(?>\\\\\\s*\\n)",
					"name": "punctuation.separator.continuation.pike"
				}
			]
		},
		{
			"begin": "(?x)\n        (?:  ^                                                    # begin-of-line\n            |\n             (?: (?= \\s )           (?<!else|return) (?<=\\w)    #  or word + space before name\n               | (?= \\s*[[:alnum:]_.|\\(\\)] )    #  or type modifier before name\n             )\n        )\n        (\\s*) (?!\\b(while|for|do|if|else|switch|catch|return|foreach|\n                   object|int|float|function|mapping|array|multiset|\n                   string|lambda|program|mixed|class)\\b\\s*)\n        (\n          (?:\n            `\\(\\)|                                              # Function call\n            `[-<.>^|&*~/+%=!\\[\\]]+|                             # Operator overloading\n            `[[:alpha:]_][[:alnum:]_]*+|                          # Getter/setter\n            [[:alpha:]_][[:alnum:]_]*+                            # function name\n          )++                                                     # Complete actual name\n        )\n         \\s*(?=\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.whitespace.function.leading.pike"
				},
				"3": {
					"name": "entity.name.function.pike"
				},
				"4": {
					"name": "punctuation.definition.parameters.pike"
				}
			},
			"end": "(?<=\\})|(?=#)|(;)",
			"name": "meta.function.pike",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#parens"
				},
				{
					"match": "\\bconstant\\b",
					"name": "storage.modifier.pike"
				},
				{
					"include": "#block"
				}
			]
		},
		{
			"include": "#type-references"
		},
		{
			"include": "#variable-names"
		}
	],
	"repository": {
		"block": {
			"begin": "\\{",
			"end": "\\}",
			"name": "meta.block.pike",
			"patterns": [
				{
					"include": "#block_innards"
				}
			]
		},
		"block_innards": {
			"patterns": [
				{
					"include": "#fncall"
				},
				{
					"include": "#block"
				},
				{
					"include": "$base"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"begin": "/\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.pike"
						}
					},
					"end": "\\*/",
					"name": "comment.block.pike"
				},
				{
					"begin": "//!(.*?)",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.pike"
						}
					},
					"end": "^\\s*(?!//!)",
					"name": "comment.block.documentation.pikedoc.pike",
					"patterns": [
						{
							"include": "#pike_doc"
						}
					]
				},
				{
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.pike"
						}
					},
					"match": "(//).*$\\n?",
					"name": "comment.line.double-slash.pike"
				}
			]
		},
		"disabled": {
			"begin": "^\\s*#\\s*if(n?def)?\\b.*$",
			"comment": "eat nested preprocessor if(def)s",
			"end": "^\\s*#\\s*endif\\b.*$",
			"patterns": [
				{
					"include": "#disabled"
				},
				{
					"include": "#pragma-mark"
				}
			]
		},
		"fncall": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "punctuation.whitespace.function-call.leading.pike"
						},
						"2": {
							"name": "support.function.any-method.pike"
						},
						"3": {
							"name": "punctuation.definition.parameters.pike"
						}
					},
					"match": "(?x)\n                     (?: (?= \\s )  (?:(?<=else|new|return) | (?<!\\w)) (\\s+))?\n                     (\\b\n                      (?!(while|for|do|if|else|foreach|lambda|switch|\n                          catch|enumerate|return|\n                          mapping|multiset|mixed|int|float|class|function|array|\n                          string|program|object|bool|auto|variant)\\s*\\()\n                        (?: `\\(\\)                  |\n                            `[-<.>^|&*~/+%=!\\[\\]]+ |\n                            `[[:alnum:]_]            |\n                            [[:alpha:]_][[:alnum:]_]*+\\b\n                        )++    # actual name\n                     )\n                     \\s*(\\()",
					"name": "meta.function-call.pike"
				},
				{
					"include": "#block"
				}
			]
		},
		"parens": {
			"begin": "\\(",
			"end": "\\)",
			"name": "meta.parens.pike",
			"patterns": [
				{
					"include": "$base"
				}
			]
		},
		"pike_doc": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "keyword.other.pikedoc.pike"
						},
						"2": {
							"name": "meta.function.pike"
						}
					},
					"match": "(@decl)\\s+(.*?)$",
					"patterns": [
						{
							"include": "$self"
						}
					]
				},
				{
					"captures": {
						"1": {
							"name": "keyword.other.pikedoc.pike"
						}
					},
					"match": "(?x)\n            (@\n              (\n                \\[.*?\\]|                # @[word]\n                [[:alnum:]]+\\{.*?@\\}|   # @word{something@}\n                [[:alnum:]]+\\{.*?        # @word{Multiline content\n              )\n              |\n              (@)\\}                      # @} closes multiline content\n            )\n          ",
					"name": "meta.tag.inline.pikedoc.pike"
				},
				{
					"match": "((https?|s?ftp|ftps|file|smb|afp|nfs|(x-)?man|gopher|txmt)://|mailto:)[-:@a-zA-Z0-9_.~%+/?=&#]+(?<![.?:])",
					"name": "markup.underline.link.pike"
				},
				{
					"captures": {
						"1": {
							"name": "keyword.other.pikedoc.pike"
						},
						"2": {
							"name": "markup.underline.link.pike"
						}
					},
					"match": "(@link)\\s+(.+)\\s*$"
				},
				{
					"match": "(?x)\n                   \\@(\n                      param|mapping|endmapping|returns|seealso|item|dl|enddl|\n                      note|module|endmodule|member|example|see|throws|pre|xml|\n                      i|b|ref|ul|endul|code|endcode|int|endint|value|\n                      string|endstring|array|endarray|fixme|ignore|endignore|\n                      image|p|link|deprecated|bugs|copyright|thanks|text|\n                      mixed|endmixed|type|ol|endol\n                   )\\b",
					"name": "keyword.other.pikedoc.pike"
				}
			]
		},
		"pragma-mark": {
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.pragma.pike"
				},
				"3": {
					"name": "meta.toc-list.pragma-mark.pike"
				}
			},
			"match": "^\\s*(#\\s*(pragma\\s+mark)\\s+(.*))",
			"name": "meta.section"
		},
		"preprocessor-rule-disabled": {
			"begin": "^\\s*(#(if)\\s+(0)\\b).*",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.if.pike"
				},
				"3": {
					"name": "constant.numeric.preprocessor.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b)",
			"patterns": [
				{
					"begin": "^\\s*(#\\s*(else)\\b)",
					"captures": {
						"1": {
							"name": "meta.preprocessor.pike"
						},
						"2": {
							"name": "keyword.control.import.else.pike"
						}
					},
					"end": "(?=^\\s*#\\s*endif\\b.*$)",
					"patterns": [
						{
							"include": "$base"
						}
					]
				},
				{
					"begin": "",
					"end": "(?=^\\s*#\\s*(else|endif)\\b.*$)",
					"name": "comment.block.preprocessor.if-branch",
					"patterns": [
						{
							"include": "#disabled"
						},
						{
							"include": "#pragma-mark"
						}
					]
				}
			]
		},
		"preprocessor-rule-disabled-block": {
			"begin": "^\\s*(#(if)\\s+(0)\\b).*",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.if.pike"
				},
				"3": {
					"name": "constant.numeric.preprocessor.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b)",
			"patterns": [
				{
					"begin": "^\\s*(#\\s*(else)\\b)",
					"captures": {
						"1": {
							"name": "meta.preprocessor.pike"
						},
						"2": {
							"name": "keyword.control.import.else.pike"
						}
					},
					"end": "(?=^\\s*#\\s*endif\\b.*$)",
					"patterns": [
						{
							"include": "#block_innards"
						}
					]
				},
				{
					"begin": "",
					"end": "(?=^\\s*#\\s*(else|endif)\\b.*$)",
					"name": "comment.block.preprocessor.if-branch.in-block",
					"patterns": [
						{
							"include": "#disabled"
						},
						{
							"include": "#pragma-mark"
						}
					]
				}
			]
		},
		"preprocessor-rule-enabled": {
			"begin": "^\\s*(#(if)\\s+(0*1)\\b)",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.if.pike"
				},
				"3": {
					"name": "constant.numeric.preprocessor.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b)",
			"patterns": [
				{
					"begin": "^\\s*(#\\s*(else)\\b).*",
					"captures": {
						"1": {
							"name": "meta.preprocessor.pike"
						},
						"2": {
							"name": "keyword.control.import.else.pike"
						}
					},
					"contentName": "comment.block.preprocessor.else-branch",
					"end": "(?=^\\s*#\\s*endif\\b.*$)",
					"patterns": [
						{
							"include": "#disabled"
						},
						{
							"include": "#pragma-mark"
						}
					]
				},
				{
					"begin": "",
					"end": "(?=^\\s*#\\s*(else|endif)\\b.*$)",
					"patterns": [
						{
							"include": "$base"
						}
					]
				}
			]
		},
		"preprocessor-rule-enabled-block": {
			"begin": "^\\s*(#(if)\\s+(0*1)\\b)",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.if.pike"
				},
				"3": {
					"name": "constant.numeric.preprocessor.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b)",
			"patterns": [
				{
					"begin": "^\\s*(#\\s*(else)\\b).*",
					"captures": {
						"1": {
							"name": "meta.preprocessor.pike"
						},
						"2": {
							"name": "keyword.control.import.else.pike"
						}
					},
					"contentName": "comment.block.preprocessor.else-branch.in-block",
					"end": "(?=^\\s*#\\s*endif\\b.*$)",
					"patterns": [
						{
							"include": "#disabled"
						},
						{
							"include": "#pragma-mark"
						}
					]
				},
				{
					"begin": "",
					"end": "(?=^\\s*#\\s*(else|endif)\\b.*$)",
					"patterns": [
						{
							"include": "#block_innards"
						}
					]
				}
			]
		},
		"preprocessor-rule-other": {
			"begin": "^\\s*(#\\s*(if(n?def)?)\\b.*?(?:(?=(?://|/\\*))|$))",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b).*$",
			"patterns": [
				{
					"include": "$base"
				}
			]
		},
		"preprocessor-rule-other-block": {
			"begin": "^\\s*(#\\s*(if(n?def)?)\\b.*?(?:(?=(?://|/\\*))|$))",
			"captures": {
				"1": {
					"name": "meta.preprocessor.pike"
				},
				"2": {
					"name": "keyword.control.import.pike"
				}
			},
			"end": "^\\s*(#\\s*(endif)\\b).*$",
			"patterns": [
				{
					"include": "#block_innards"
				}
			]
		},
		"string_escaped_char": {
			"patterns": [
				{
					"match": "\\\\(\\\\|[0-3]\\d{,2}|[4-7]\\d?|x[a-fA-F0-9]{,2}|u[a-fA-F0-9]{,4}|U[a-fA-F0-9]{,8}|d[0-9]+|[[:alnum:]'\"?])",
					"name": "constant.character.escape.pike"
				},
				{
					"match": "\\\\.",
					"name": "invalid.illegal.unknown-escape.pike"
				}
			]
		},
		"string_placeholder": {
			"patterns": [
				{
					"match": "(?x)%\n                  (?!\\s|%)                            # Not followed by space or %\n                  \\*?                                 # May be followed by a *\n                  (\\d+\\$)?                           # field (argument #)\n                  [*#0\\- +'\\[\\]]*                   # flags\n                  [,;:_]?                              # separator character (AltiVec)\n                  ((-?\\d+)|\\*(-?\\d+\\$)?)?          # minimum field width\n                  (\\.((-?\\d+)|\\*(-?\\d+\\$)?)?)?    # precision\n                  (hh|h|ll|l|j|t|z|q|L|vh|vl|v|hv|hl)? # length modifier\n                  [diouxXDOUeEfFgGaACcSspnYyMmDdHhWtzp%{}]         # conversion type",
					"name": "constant.other.placeholder.pike"
				},
				{
					"match": "%(?!\\s|%)(!<%)",
					"name": "invalid.illegal.placeholder.pike"
				}
			]
		},
